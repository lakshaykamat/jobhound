#!/usr/bin/env bash
# One-shot setup: extract fit_profile from your resume, derive queries, write config.json.
# Forwards any extra args (e.g. --force, an explicit resume path) to the underlying CLI.
#
# Usage:
#   ./bootstrap                       # auto-detect resume in data/
#   ./bootstrap --force               # overwrite an existing config.json
#   ./bootstrap path/to/resume.pdf    # explicit path

set -euo pipefail

cd "$(dirname "$0")"

if ! command -v node >/dev/null 2>&1; then
  echo "node not found. Install Node.js 22+ (https://nodejs.org) and re-run." >&2
  exit 1
fi

if [ ! -f .env ]; then
  echo ".env not found. Copy .env.example to .env and fill in your 4 API keys before running bootstrap." >&2
  exit 1
fi

if [ ! -d node_modules ]; then
  echo "installing dependencies (one-time)…"
  npm install --silent
fi

exec npm run --silent bootstrap -- "$@"
