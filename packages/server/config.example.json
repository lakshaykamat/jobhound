{
  "cycle": {
    "queries": [
      "<role> remote <region>",
      "<role> <city>"
    ],
    "score_threshold": 70,
    "max_pages_per_query": 1,
    "dedup_strategy": "title_company_via",
    "max_job_age_days": 7
  },
  "server": {
    "poll_interval_seconds": 21600,
    "http_port": 8787
  },
  "serpapi": {
    "country": "us",
    "language": "en",
    "platforms": [
      "linkedin",
      "wellfound",
      "lever",
      "greenhouse",
      "ashby"
    ]
  },
  "openai": {
    "model": "gpt-5.2",
    "llm_concurrency": 4
  },
  "features": {
    "tailor_resume": true
  },
  "secrets": {
    "serpapi_keys": ["<your-serpapi-key>"],
    "openai_key": "<your-openai-key>"
  },
  "profile": {
    "skills": ["<lowercase canonical tech token>", "..."],
    "seniority": "junior | mid | senior | staff | principal",
    "years_experience": 0,
    "domains": ["<lowercase domain token>", "..."],
    "role_titles": ["<past or family-preference role>", "..."],
    "locations": ["<city>", "remote"],
    "work_authorization": ["<iso 3166-1 alpha-2, e.g. 'in', 'us', 'gb'>"],
    "work_mode_preference": ["remote", "hybrid", "onsite"],
    "relocation_open": false,
    "preferred_company_size": ["startup", "scaleup", "enterprise"],
    "availability": "<e.g. 'immediate', '2 weeks notice', '1 month notice'>",
    "min_annual_salary": null,
    "compensation_currency": "<iso 4217, e.g. 'inr', 'usd'>",
    "highlights": ["<verb-led achievement with metric/scope>", "..."],
    "notes": "<one short sentence: anything distinctive other fields don't capture>"
  }
}
